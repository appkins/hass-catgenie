# Tools container: adb + frida + python. Talks to the emulator over TCP adb,
# so the host needs nothing but Docker.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        adb \
        curl \
        xz-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# frida-tools pins a frida version; setup-frida.sh downloads the matching
# frida-server so client and server never mismatch.
RUN pip install --no-cache-dir frida-tools

COPY setup-frida.sh extract.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/setup-frida.sh /usr/local/bin/extract.sh

WORKDIR /work
